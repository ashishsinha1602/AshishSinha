# Copy this file to .env and fill in ONE of the two engines below.
# db-detective auto-detects which engine to use from the variables present.

# ── Option A: PostgreSQL ────────────────────────────────────────────────
# Works with local docker, Supabase, Neon, RDS, etc.
DATABASE_URL=postgresql://user:password@localhost:5432/mydb

# ── Option B: Oracle (incl. Autonomous DB with a wallet) ────────────────
# Unzip the wallet you downloaded from OCI somewhere, then point at it.
# ORACLE_USER=ADMIN
# ORACLE_PASSWORD=your-db-password
# ORACLE_DSN=mydb_high                 # a TNS alias from the wallet's tnsnames.ora
# ORACLE_WALLET_DIR=C:\path\to\wallet  # folder containing tnsnames.ora + cwallet.sso
# ORACLE_WALLET_PASSWORD=              # only if the wallet itself is password-protected
